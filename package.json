{
  "name": "chess-game-importer",
  "version": "1.0.0",
  "description": "Imports chess games from Lichess or Chess.com, analyzes them, then stores them in a sqlite database",
  "license": "MIT",
  "author": "Nathan Loding",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "chess-game-importer": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "nodemon",
    "worker": "nodemon --config nodemon.worker.json",
    "worker:debug": "nodemon --config nodemon.worker.json --inspect-brk",
    "cli": "NODE_OPTIONS=\"-r ts-node/register\" node src/cli/index.ts",
    "cli:debug": "NODE_OPTIONS=\"-r ts-node/register --inspect-brk\" node src/cli/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\""
  },
  "dependencies": {
    "@temporalio/activity": "^1.11.2",
    "@temporalio/client": "^1.11.2",
    "@temporalio/worker": "^1.11.2",
    "@temporalio/workflow": "^1.11.2",
    "better-sqlite3": "^11.7.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "date-fns": "^2.30.0",
    "kokopu": "^4.13.1",
    "nanoid": "^5.0.0",
    "stockfish": "^17.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^7.3.1",
    "@typescript-eslint/parser": "^7.3.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nock": "^14.0.10",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.3"
  }
}
